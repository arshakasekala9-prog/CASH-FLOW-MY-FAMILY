rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data tiap akun hanya bisa dibaca dan ditulis oleh akun itu sendiri.
    match /users/{uid}/expenses/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'amount', 'date', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount < 1000000000000
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Selain itu, semuanya terkunci.
  }
}
